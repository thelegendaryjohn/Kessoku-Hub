<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>
  <link rel="stylesheet" href="/css/store/cart.css">

  <title>Kessoku Hub | Store</title>
</head>

<body>
  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "CART" , headerColor: "var(--ryo-color)"}) %>

  <!-- Cart page -->
  <main>

    <% if(!cart) {%>
    <!-- no item placeholder -->
    <div class="no-item-placeholder">* There are no item in your cart</div>
    <% } %>

    <!-- item list container -->
    <div id="item-list-container">
      <% let totalPrice = 0; %>
      <% for (let id in cart) { %>
      <div class="item-container" id="<%- id %>">
        <img class="item-image" src="/images/store-section/<%- items[id].imageName%>" alt="<%- items[id].description%>">
        <div class="item-name"> <%- items[id].name%> </div>

        <!-- item's right container -->
        <div class="item-right-container">
          <div class="item-price"><span class="item-price-number"><%- items[id].price * cart[id]%></span> $</div>
          <button class="item-minus-button qty-btn">-</button>
          <div class="item-quantity"><%- cart[id]%></div>
          <button class="item-plus-button qty-btn">+</button>
        </div>
      </div>
      <% totalPrice += items[id].price * cart[id]; %>
      <% } %>
    </div>

    <!-- total price -->
    <div id="check-out-container">
      <div id="total-price" class="item-price">Total Price: <span id="total-price-number"><%- totalPrice %></span> $</div>
      <a class="check-out-btn" href="/store/remove/all">Check out</a>
    </div>

    <!-- Cart page button container -->
    <a href="/store">
      <div id="cart-button-container">
        <svg fill="#2254c0" class="cart-svg" height="800px" width="800px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 483.1 483.1" xml:space="preserve">
          <g>
            <path d="M434.55,418.7l-27.8-313.3c-0.5-6.2-5.7-10.9-12-10.9h-58.6c-0.1-52.1-42.5-94.5-94.6-94.5s-94.5,42.4-94.6,94.5h-58.6
            c-6.2,0-11.4,4.7-12,10.9l-27.8,313.3c0,0.4,0,0.7,0,1.1c0,34.9,32.1,63.3,71.5,63.3h243c39.4,0,71.5-28.4,71.5-63.3
            C434.55,419.4,434.55,419.1,434.55,418.7z M241.55,24c38.9,0,70.5,31.6,70.6,70.5h-141.2C171.05,55.6,202.65,24,241.55,24z
            M363.05,459h-243c-26,0-47.2-17.3-47.5-38.8l26.8-301.7h47.6v42.1c0,6.6,5.4,12,12,12s12-5.4,12-12v-42.1h141.2v42.1
            c0,6.6,5.4,12,12,12s12-5.4,12-12v-42.1h47.6l26.8,301.8C410.25,441.7,389.05,459,363.05,459z" />
          </g>
        </svg>
      </div>
    </a>

  </main>

  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs") %>
</body>

<!-- add the items array from the route/store.js -->
<% if (items) { %>
<script>
  const items = <%- JSON.stringify(items) %>;
  const cart = <%- JSON.stringify(cart) %>;
</script>
<% } %>

<script>
  // initialize
  const itemPlusBtn = document.querySelectorAll(".item-plus-button");
  const itemMinusBtn = document.querySelectorAll(".item-minus-button");
  const totalPriceNumber = document.querySelector("#total-price-number")

  // Listening to the add to cart button
  itemPlusBtn.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      const itemId = e.target.parentElement.parentElement.id; // parent id 3,2,5
      const curPlusBtn = e.target.parentElement.querySelector('.item-plus-button');
      const curItemQty = e.target.parentElement.querySelector('.item-quantity');
      const curItemPrice = e.target.parentElement.querySelector('.item-price .item-price-number');
      curItemQty.textContent = Number(curItemQty.textContent) + 1;
      curItemPrice.textContent = Number(curItemPrice.textContent) + items[itemId].price;
      totalPriceNumber.textContent = Number(totalPriceNumber.textContent) + items[itemId].price;
      fetch(`/store/add/${itemId}`, {
          method: "POST",
        })
        .then((res) => {
          if (res.ok) {
            return res.json();
          } else {
            throw new Error("Failed to add item to cart");
          }
        })
    });
  });

  // Listening to the remove from cart button
  itemMinusBtn.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      const itemId = e.target.parentElement.parentElement.id; // parent id 3,2,5
      const curMinusBtn = e.target.parentElement.querySelector('.item-minus-button');
      const curItemQty = e.target.parentElement.querySelector('.item-quantity');
      const curItemPrice = e.target.parentElement.querySelector('.item-price .item-price-number');
      if (Number(curItemQty.textContent) > 1) {
        curItemQty.textContent = Number(curItemQty.textContent) - 1;
        curItemPrice.textContent =
          Number(curItemPrice.textContent) - items[itemId].price;
        totalPriceNumber.textContent = Number(totalPriceNumber.textContent) - items[itemId].price;
      } else {
        totalPriceNumber.textContent = Number(totalPriceNumber.textContent) - items[itemId].price;
        btn.parentElement.parentElement.remove();
      }
      fetch(`/store/remove/${itemId}`, {
          method: "POST",
        })
        .then((res) => {
          if (res.ok) {
            return res.json();
          } else {
            throw new Error("Failed to remove item from cart");
          }
        })
    });
  });
</script>

</html>