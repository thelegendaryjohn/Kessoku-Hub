<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>
  <link rel="stylesheet" href="/css/store/cart.css">

  <title>Kessoku Hub | Store</title>
</head>

<body>
  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "CART" , headerColor: "var(--ryo-color)"}) %>

  <!-- Cart page -->
  <main>
    <!-- item list container -->
    <div id="item-list-container">
    </div>
    <!-- total price -->
    <div id="total-price-container item-price">
      <div id="total-price">Total Price: <span class="total-price-number">0</span> $</div>
      <button class="check-out-btn">Check out</button>
    </div>


    <!-- Cart page button container -->
    <a href="/store">
      <div id="cart-button-container">
        <svg fill="#2254c0" class="cart-svg" height="800px" width="800px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 483.1 483.1" xml:space="preserve">
          <g>
            <path d="M434.55,418.7l-27.8-313.3c-0.5-6.2-5.7-10.9-12-10.9h-58.6c-0.1-52.1-42.5-94.5-94.6-94.5s-94.5,42.4-94.6,94.5h-58.6
            c-6.2,0-11.4,4.7-12,10.9l-27.8,313.3c0,0.4,0,0.7,0,1.1c0,34.9,32.1,63.3,71.5,63.3h243c39.4,0,71.5-28.4,71.5-63.3
            C434.55,419.4,434.55,419.1,434.55,418.7z M241.55,24c38.9,0,70.5,31.6,70.6,70.5h-141.2C171.05,55.6,202.65,24,241.55,24z
            M363.05,459h-243c-26,0-47.2-17.3-47.5-38.8l26.8-301.7h47.6v42.1c0,6.6,5.4,12,12,12s12-5.4,12-12v-42.1h141.2v42.1
            c0,6.6,5.4,12,12,12s12-5.4,12-12v-42.1h47.6l26.8,301.8C410.25,441.7,389.05,459,363.05,459z" />
          </g>
        </svg>
      </div>
    </a>

  </main>

  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs") %>
</body>
<% if (items) { %>
<script>
  const items = <%- JSON.stringify(items) %>;
</script>
<% } %>
<!-- add the items array from the route/cart.js -->
<script type="module">
  // get and filter out the cart string
  let cartString = '<%- JSON.stringify(cart) %>';
  let newStringEnd = cartString.indexOf("m") - 3;
  cartString = cartString.substr(1, newStringEnd);

  // create an cart items array
  let itemArray = []
  for (let i = 0; i < cartString.length; i++) {
    if (cartString[i] === ":") {
      let newItemID = cartString.charAt(i - 2);
      let newItemQuantity = cartString.charAt(i + 1);
      let newItem = {
        id: newItemID,
        quantity: newItemQuantity
      };
      itemArray.push(newItem);
    }
  }

  let totalPrice = 0;
  // create element for each item inside itemArray
  const itemListContainer = document.querySelector("#item-list-container");
  itemArray.forEach(item => {
    // item container
    let newItemContainer = document.createElement("div");
    newItemContainer.classList.add("item-container");
    newItemContainer.id = item.id;
    itemListContainer.appendChild(newItemContainer);

    // item image
    let newItemImage = document.createElement("img");
    newItemImage.classList.add("item-image");
    newItemImage.src = "/images/store-section/" + items[item.id].imageName;
    newItemImage.alt = items[item.id].name;
    newItemContainer.appendChild(newItemImage);

    // item name
    let newItemName = document.createElement("div");
    newItemName.classList.add("item-name");
    newItemName.innerText = items[item.id].name;
    newItemContainer.appendChild(newItemName);

    // item quantity
    let newItemQuantity = document.createElement("div");
    newItemQuantity.classList.add("item-quantity");
    newItemQuantity.innerText = item.quantity;
    newItemContainer.appendChild(newItemQuantity);

    // item price
    let newItemPrice = document.createElement("div");
    newItemPrice.classList.add("item-price");
    newItemPrice.innerText = items[item.id].price * item.quantity + " $";
    totalPrice += items[item.id].price * item.quantity;
    newItemContainer.appendChild(newItemPrice);

    // item delete
    let newItemDelete = document.createElement("div");
    newItemDelete.classList.add("item-delete");
    newItemContainer.appendChild(newItemDelete);

    // item delete anchor
    let newItemDeleteAnchor = document.createElement("a");
    newItemDeleteAnchor.classList.add("item-delete-anchor");
    newItemDeleteAnchor.innerText = "Delete";
    newItemDeleteAnchor.href = "/store/remove/" + item.id;
    newItemContainer.appendChild(newItemDeleteAnchor);
  });

  // update total price
  let totalPriceNumber = document.querySelector(".total-price-number");
  totalPriceNumber.innerText = totalPrice;
</script>

</html>