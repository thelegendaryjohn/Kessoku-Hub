<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>
  <link rel="stylesheet" href="/css/store/store.css">

  <title>Kessoku Hub | Store</title>
</head>

<body>
  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "STORE" }) %>

  <!-- Store page -->
  <main>
    <!-- Item list container -->
    <div id="item-list-container">
      <!-- Dynamically generate the item container -->
      <% items.forEach(item => { %>
      <div class="item-container">
        <img class="item-image" src="images/store-section/<%- item.imageName%>" alt="<%- item.description%>">
        <div class="item-name"><%- item.name%></div>
        <div class="item-description"><%- item.description%></div>
        <div class="price-stock-container">
          <div class="item-price"><%- item.price%>$</div>
          <div class="item-stock">in stock: <%- item.stock%></div>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="pop-up-container">
    </div>
    <!-- Cart page button container -->
    <div></div>

    <!-- pop up container -->
    <div id="pop-up-container">
        <div class="image-close-btn-container">
          <img class="pop-up-image" src="images/store-section/<%- items[0].imageName%>" alt="<%- items[0].description%>">
        <button id="close-pop-up-btn">X</button>
        </div>
        <div class="description-container">
            <div class="item-name"><%- items[0].name%></div>
            <div class="item-description"><%- items[0].description%></div>
            <div class="item-price"><%- items[0].price%> $</div>
        </div>
        <span id="instruction">Select your size</span>
        <div class="size-selection-container">
          <button class="size-btn selected-btn" id="size-s">Size S</button>
          <button class="size-btn" id="size-m">Size M</button>
          <button class="size-btn" id="size-l">Size L</button>
        </div>
        <button id="add-to-cart-btn">Add to cart</button>
      </div>
  </main>

  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs") %>
</body>

<script type="module">
//initialize
const items = document.querySelectorAll(".item-container");
const closePopUpBtn = document.querySelector("#close-pop-up-btn");
const popup = document.getElementById("pop-up-container");
const allSizeBtn = document.querySelectorAll(".size-btn");

//close the pop up when user click the close button
closePopUpBtn.addEventListener("click",()=>{
  popup.style.display = "none";
});

//when click on any item show the popup
items.forEach((e)=> {
  e.addEventListener("click",() => {
    popup.style.display = "flex";
  })
})

//turn off other button when one is clicked
function turnOffBtn(clickedBtn) {
  allSizeBtn.forEach((btnInfo, i)=> {
    if (clickedBtn.id !== btnInfo.id) {
      btnInfo.classList.remove("selected-btn")
    }
  })
}

//add eventListener for all size buttons
allSizeBtn.forEach((btn)=>{
  btn.addEventListener("click",(e)=>{
      e.target.classList.add("selected-btn");
      turnOffBtn(e.target);
  })
})

</script>

</html>