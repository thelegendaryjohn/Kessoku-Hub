<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>
  <link rel="stylesheet" href="/css/store/store.css">

  <title>Kessoku Hub | Store</title>
</head>

<body>
  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "STORE" }) %>

  <!-- Store page -->
  <main>
    <!-- Item list container -->
    <div id="item-list-container">
      <!-- Dynamically generate the item container -->
      <% items.forEach(item => { %>
      <div class="item-container" id="<%- item.id%>">
        <img class="item-image" src="images/store-section/<%- item.imageName%>" alt="<%- item.description%>">
        <div class="item-name"><%- item.name%></div>
        <div class="item-description"><%- item.description%></div>
        <div class="price-stock-container">
          <div class="item-price"><%- item.price%>$</div>
          <div class="item-stock">in stock: <%- item.stock%></div>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="pop-up-container">
    </div>
    <!-- Cart page button container -->
    <div></div>

    <!-- pop up container -->
    <form action="#">
      <div id="pop-up-container">
        <div class="image-close-btn-container">
          <img id="pop-up-image" class="pop-up-image" src="images/store-section/<%- items[0].imageName%>" alt="<%- items[0].description%>">
        <button id="close-pop-up-btn">X</button>
        </div>
        <div class="description-container">
            <div class="item-name" id="pop-up-name"><%- items[0].name%></div>
            <div class="item-price" id="pop-up-price"><%- items[0].price%> $</div>
        </div>
        <div class="size-selection-container">
          <button type="radio" name="size" class="size-btn selected-btn" id="size-s">Size S</button>
          <button type="radio" name="size" class="size-btn" id="size-m">Size M</button>
          <button type="radio" name="size" class="size-btn" id="size-l">Size L</button>
        </div>
        <div class="qty-selection-container">
            <button class="qty-btn" id="qty-minus" type="button">-</button>
            <input class="qty-input" type="number"  min="0" max="10" value="1">
            <button class="qty-btn" id="qty-plus" type="button">+</button>
        </div>
        <button type="submit" id="add-to-cart-btn">Add to cart</button>
    </div>
    </form>
  </main>

  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs") %>
</body>

<script type="module">
//import itemsArray
import {
    items
  } from "/js/store/items.js";
//initialize
const itemsList = document.querySelectorAll(".item-container");
const closePopUpBtn = document.querySelector("#close-pop-up-btn");
const popup = document.querySelector("#pop-up-container");
const allSizeBtn = document.querySelectorAll(".size-btn");
const qtyInput = document.querySelector(".qty-input");
const qtyMinus = document.querySelector("#qty-minus");
const qtyPlus = document.querySelector("#qty-plus");

//close the pop up when user click the close button
closePopUpBtn.addEventListener("click",()=>{
  popup.style.display = "none";
});

//when click on any item show the popup
itemsList.forEach((item)=> {
  item.addEventListener("click",() => {
    popup.style.display = "flex";
    // update information to the pop up
    document.querySelector("#pop-up-name").innerText = items[item.id].name;
    document.querySelector("#pop-up-image").src = "images/store-section/" + items[item.id].imageName;
    document.querySelector("#pop-up-price").innerText = items[item.id].price + "$";
  })
})

//turn off other button when one is clicked
function turnOffBtn(clickedBtn) {
  allSizeBtn.forEach((btnInfo, i)=> {
    if (clickedBtn.id !== btnInfo.id) {
      btnInfo.classList.remove("selected-btn")
    }
  })
}

//add eventListener for all size buttons
allSizeBtn.forEach((btn)=>{
  btn.addEventListener("click",(e)=>{
      e.target.classList.add("selected-btn");
      turnOffBtn(e.target);
  })
})
//quantity selection buttons
qtyMinus.addEventListener("click",()=>{
  if (qtyInput.value > qtyInput.min && Number(qtyInput.value) <= qtyInput.max) {
    qtyInput.value -= 1;
  }
  else {
    qtyInput.value = qtyInput.min;
  }
})
qtyPlus.addEventListener("click",()=>{
  if (qtyInput.value >= qtyInput.min && Number(qtyInput.value) < qtyInput.max) {
    qtyInput.value = Number(qtyInput.value) + 1;
  }
  else{
    qtyInput.value = qtyInput.max;
  }
})

</script>

</html>