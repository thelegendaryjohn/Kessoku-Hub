<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Music</title>
  <link rel="stylesheet" href="/css/music/music.css">
</head>

<body>

  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "MUSIC", headerColor: "var(--hitori-color)" }) %>

  <!-- Cookies consent banner -->
  <%- include("../partials/popup/cookiesConsentPopup.ejs") %>

  <main>
    <!-- Music section -->
    <section id="music">
      <div id="album-container" class="section-container">
        <%- include("../partials/landing/music-section/albumHeader.ejs") %>

        <!-- <div class="play-all-btn"></div> -->

        <div id="album-song-list">
          <% songs.forEach((song, index) => { %>
          <%- include("../partials/landing/music-section/albumSong.ejs", {
                index: song.index,
                name: song.songName,
                length: song.length,
                url: song.url,
              }) %>
          <% }) %>

        </div>
      </div>

      <%- include("../partials/music/audioWidget.ejs") %>

      <script src="/js/landing/music-section/songSelection.js"></script>
    </section>

  </main>

  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs") %>
</body>

</html>