<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Error Page</title>
  <link rel="stylesheet" href="/css/error.css">
</head>

<body>
  <!-- Desktop nav bar partial -->
  <%- include("partials/navBarDesktop.ejs") %>

  <!-- Sidebar -->
  <%- include("partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("partials/navBar.ejs", { headerTitle: "ERROR", headerColor: "var(--ikuyo-color)" }) %>

  <main id="error-container">
    <img src="/images/error-page/kita-gif.gif" id="error-gif">
    <h1 id="error-code"><%= error %></h1>
    <h2 id="error-desc"><%= errorMessage %></h2>

    <a href="/" id="exit-button">
      <h1 class="btn">GO HOME</h1>
    </a>
  </main>



  <!-- Footer partial -->
  <%- include("partials/htmlFooter.ejs") %>
</body>

</html>