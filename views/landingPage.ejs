<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("partials/htmlHead.ejs") %>

  <title>Kessoku Band Fan Site | Home</title>
  <link rel="stylesheet" href="/css/landing.css">
</head>

<body>
  <script>
    let characters = "<%= characters %>";
  </script>
  <!-- HTML Body -->
  <main>
    <section class="text-shadow">
      <div id="banner">
        <img id="banner-img" src="/images/top-section/top-bg-nr.jpg" alt="Landing page banner">
        <div id="banner-img-overlap" class="banner-overlap">
          <img id="banner-logo" src="/images/top-section/band-logo.svg" alt="Landing page banner logo">
          <div id="banner-text">
            <h2 id="banner-name">BOCCHI<br>&nbsp;THE ROCK!</h2>
            <h3 id="banner-desc">THEATER COMPILATION</h3>
          </div>
        </div>
      </div>
    </section>

    <section id="characters" class="text-shadow">
      <h2 id="char-header">CHARACTER</h2>
      <ul id="char-btn-list">
        <!-- Create char btns -->
        <% characters.forEach((e) => { %>
        <li class="char-btn"><%= e.id.toUpperCase() %></li>
        <% }); %>
      </ul>
    </section>
    <article class="char-card">
      <!-- Character card content -->

      <div id="char-card-bg">
        <div id="band-ribbon">
          <p id="band-ribbon-text">KESSOKUBAND</p>
        </div>
        <p id="char-name-ribbon">HIORI GOTOH</p>
      </div>
      <div id="char-container">
        <img id="char-img" src="/images/character-section/character/bocchi.png" alt="Hitori Gotoh standing photo">
        <img id="char-img-layer" src="/images/character-section/character/bocchi-layer.png" alt="Hitori Gotoh standing photo">
        <img class="char-heads" src="/images/character-section/character/bocchi-3pics.png" alt="Hitori's face expressions">
        <img id="bocchi-third-head" class="char-heads" src="/images/character-section/character/bocchi-face-1.png" alt="Hitori's face expressions">
      </div>
      <div id="card-text-container" class="text-shadow">
        <h1 id="char-name">Hitori Gotoh</h1>
        <h2 id="char-va">VA: Yoshino Aoyama</h2>
        <h2 id="char-role">『 Guitarist 』</h2>
        <p id="char-desc">A high school freshman who is extremely shy and introverted. She used to suffer from anxiety that was so bad it affected her studies but found solace in playing guitar.</p>
      </div>

    </article>

    <section id="news-forum">
      <h2>NEWS &amp; FORUM</h2>
      <p>Date 12.7.24</p>
      <p>Sales of collaboration models with Walkman R have started!</p>
    </section>
    <section id="music">
      <h2>MUSIC</h2>
      <p>Date 12.7.24</p>
      <p>Sales of collaboration models with Walkman R have started!</p>
    </section>
    <section id="the-series">
      <h2>THE SERIES</h2>
      <div class="episode">
        <p>E6 - Eight Views</p>
      </div>
    </section>
    <section id="store">
      <h2>STORE</h2>
      <!-- Store content -->
    </section>
  </main>

  <!-- Footer partial -->
  <%- include("partials/htmlFooter.ejs") %>
  <script src="/js/landing.js" type="module"></script>
  <script src="/js/root.js" type="module"></script>
</body>

</html>