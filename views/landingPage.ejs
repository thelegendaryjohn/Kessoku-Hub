<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("partials/htmlHead.ejs") %>

  <title>Kessoku Band Fan Site | Home</title>
  <link rel="stylesheet" href="/css/landing.css">
</head>

<body>
  <main>
    <section class="text-shadow">
      <div id="banner">
        <img id="banner-img" src="/images/top/top-bg-nr.jpg" alt="Landing page banner">
        <div id="banner-img-overlap" class="banner-overlap">
          <img id="banner-logo" src="/images/top/band-logo.svg" alt="Landing page banner logo">
          <div id="banner-text">
            <h2 id="banner-name">BOCCHI<br>&nbsp;THE ROCK!</h2>
            <h3 id="banner-desc">THEATER COMPILATION</h3>
          </div>
        </div>
      </div>
    </section>

    <section id="characters" class="text-shadow">
      <h2 id="char-header">CHARACTER</h2>
      <ul>
        <li class="btn-underline">HITORI</li>
        <li>NIJIKA</li>
        <li>RYU</li>
        <li>IKUYO</li>
      </ul>
    </section>
    <article class="char-card">
      <div id="char-card-bg">
        <div id="band-ribbon">
          <p id="band-ribbon-text">KESSOKUBAND</p>
        </div>
        <p id="char-name-ribbon">HITORI GOTOH</p> <!-- Insert character name here -->
      </div>
      <div id="char-container">
        <img id="char-img" src="/images/character-section/characters/bocchi.png" alt="Hitori Gotoh standing photo">
        <img id="char-img-backdrop" src="/images/character-section/characters/bocchi-backdrop.png" alt="Hitori Gotoh standing photo">
      </div>
    </article>

    <section id="news-forum">
      <h2>NEWS &amp; FORUM</h2>
      <p>Date 12.7.24</p>
      <p>Sales of collaboration models with Walkman R have started!</p>
    </section>
    <section id="music">
      <h2>MUSIC</h2>
      <p>Date 12.7.24</p>
      <p>Sales of collaboration models with Walkman R have started!</p>
    </section>
    <section id="the-series">
      <h2>THE SERIES</h2>
      <div class="episode">
        <p>E6 - Eight Views</p>
      </div>
    </section>
    <section id="store">
      <h2>STORE</h2>
      <!-- Store content -->
    </section>
  </main>

  <!-- Footer partial -->
  <%- include("partials/htmlFooter.ejs") %>
</body>

</html>