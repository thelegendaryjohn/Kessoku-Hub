  <main>
    <section id="characters">
      <h2 id="char-header">CHARACTER</h2>
      <ul>
        <li class="btn-underline">HITORI</li>
        <li>NIJIKA</li>
        <li>RYU</li>
        <li>IKUYO</li>
      </ul>
    </section>
    <article class="char-card">
      <h2>Hitori Gotoh</h2>
      <h3>VA: Yoshino Aoyama</h3>
      <h3>[Guitarist]</h3>
      <p>A high school freshman who is extremely shy and introverted. She used to suffer from anxiety that was so bad it affected her studies but found solace in playing guitar.</p>
    </article>
    <section id="news-forum">
      <h2>NEWS & FORUM</h2>
      <p>Date 12.7.24</p>
      <p>Sales of collaboration models with Walkman R have started!</p>
    </section>
    <section id="music">
      <h2>MUSIC</h2>
      <p>Date 12.7.24</p>
      <p>Sales of collaboration models with Walkman R have started!</p>
    </section>
    <section id="the-series">
      <h2>THE SERIES</h2>
      <div class="episode">
        <p>E6 - Eight Views</p>
      </div>
    </section>
    <section id="store">
      <h2>STORE</h2>
      <!-- Store content -->
    </section>
  </main>
  <footer>
    <div class="support">
      <a href="#">Support</a>
      <a href="#">About site</a>
    </div>
    <p>All rights reserved © 2022 CloverWorks Studios & Aniplex</p>
  </footer>
