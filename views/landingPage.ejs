<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Home</title>
  <link rel="stylesheet" href="/css/landing/main.css">
  <link rel="stylesheet" href="/css/landing/anim.css">
  <link rel="stylesheet" href="/css/forum/forum.css">
  <link rel="stylesheet" href="/css/landing/store.css">
  <link rel="stylesheet" href="/css/landing/video.css">
  <link rel="stylesheet" href="/css/landing/music.css">
</head>

<body class="<%= env == 'prod' ? 'adjustColor' : '' %>">
  <!-- Sidebar -->
  <%- include("partials/sidebar.ejs") %>

  <!-- HTML Body -->
  <main class="<%= env == 'prod' ? 'adjustOpacity' : '' %>">

    <div class="desktop-row-container">
      <!-- Header banner -->
      <section id="header-banner" class="text-shadow">
        <div id="banner">
          <img id="banner-img" src="/images/top-section/top-bg-nr.jpg" alt="Landing page banner" class="<%= env == 'prod' ? 'adjustBrightness' : '' %>">
          <div id="banner-img-overlap" class="banner-overlap">
            <img id="banner-logo" src="/images/top-section/band-logo.svg" alt="Landing page banner logo" class="<%= env == 'prod' ? 'adjustOpacity' : '' %>">
            <div id="banner-text" class="<%= env == 'prod' ? 'adjustOpacity' : '' %>">
              <h2 id="banner-name">BOCCHI<br>&nbsp;THE ROCK!</h2>
              <h3 id="banner-desc">THEATER COMPILATION</h3>
            </div>
          </div>
        </div>
      </section>

      <!-- Characters -->
      <%- include("partials/landing/character.ejs") %>
    </div>


    <!-- Other sections -->
    <div id="other-sections" class="text-shadow">
      <div class="desktop-row-container">
        <!-- Forum -->
        <%- include("partials/landing/forum-section/forumContainer.ejs") %>

        <!-- Music -->
        <%- include("partials/landing/music-section/albumContainer.ejs", { isLanding: true }) %>
      </div>

      <div class="desktop-row-container">
        <!-- Series -->
        <%- include("partials/landing/video-section/videoContainer.ejs") %>

        <!-- Store -->
        <%- include("partials/landing/store-section/storeContainer.ejs") %>
      </div>

    </div>

  </main>

  <!-- Cookies consent banner -->
  <%- include("partials/popup/cookiesConsentPopup.ejs") %>

  <!-- Footer partial -->
  <%- include("partials/htmlFooter.ejs") %>
  <!-- <script src="/js/global.js" type="module"></script> -->
</body>

</html>