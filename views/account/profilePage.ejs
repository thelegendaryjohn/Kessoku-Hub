<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>
  <!-- <link rel="stylesheet" href="/css/account/menu.css"> -->
  <link rel="stylesheet" href="/css/account/profile.css">

  <title>Kessoku Hub | Settings</title>
</head>

<body>
  <!-- Desktop nav bar partial -->
  <%- include("../partials/navBarDesktop.ejs") %>

  <!-- Sidebar partial -->
  <%- include("../partials/sidebar.ejs", { profileView: true }) %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "PROFILE" }) %>

  <!-- Cookies consent banner -->
  <%- include("../partials/popup/cookiesConsentPopup.ejs") %>

  <!-- Welcome page -->
  <main>
    <!-- Function buttons -->
    <div id="function-btn-container" class="section-container">
      <a style="display: <%= locals.user?.username === locals.targetedUser.username ? "flex" : "none" %>;" id="edit-profile-btn" class="function-btn" href="/account/profile">
        <p class="function-name">Edit</p>
        <img class="function-img" src="/images/account-section/edit-pen-icon.svg" alt="Edit Profile">
      </a>
      <%- include("../partials/forum/threeDotsMenu.ejs", { isProfile: true }) %>
    </div>


    <!-- User profile header -->
    <div id="user-card-container" class="section-container">
      <!-- User profile -->
      <div id="profile-container">
        <img id="profile-img" src="<%= locals.targetedUser ? `/${targetedUser.avatar}` : `/images/account-section/user-icon.svg` %>" alt="Profile image">

        <h1 id="profile-name"><%= targetedUser.username %></h1>

        <h3 id="unverified-badge" class="account-badge" style="display: <%= isNotVerified ? "block" : "none" %>">Unverified ✖</h3>
        <h3 id="verified-badge" class="account-badge" style="display: <%= isVerified ? "block" : "none" %>;">Verified ✔</h3>
        <h3 id="admin-badge" class="account-badge" style="display: <%= isAdmin ? "block" : "none" %>">Admin ⚒</h3>
        <h3 id="unverified-badge" class="account-badge bad-badge" style="display: <%= locals.targetedUser.isRestricted ? "block" : "none" %>">✖ Restricted</h3>
        <h3 id="unverified-badge" class="account-badge bad-badge" style="display: <%= locals.targetedUser.isBanned ? "block" : "none" %>">✖ Banned</h3>
      </div>

      <!-- User stats -->
      <div id="stats-container">
        <!-- Join date -->
        <div id="join-date-container">
          <p id="join-date-header" class="stats-header">Joined </p>
          <p id="join-date-text" class="stats-text"><%- include("../partials/forum/forumDate.ejs", {obj: targetedUser}) %></p>
        </div>

        <!-- Post count -->
        <div id="post-container">
          <p id="post-header" class="stats-header">Posts</p>
          <p id="post-text" class="stats-text"><%= postCount %></p>
        </div>

        <!-- Comment count -->
        <div id="comment-container">
          <p id="comment-header" class="stats-header">Comments</p>
          <p id="comment-text" class="stats-text"><%= commentCount %></p>
        </div>
      </div>

    </div>

    <div class="section-divider"></div>

    <div id="user-detail-container" class="section-container">
      <!-- Bio -->
      <div id="bio-container" class="detail-container">
        <p id="bio-header" class="detail-header">Bio</p>
        <p id="bio-text" class="detail-text font-poppins"><%= targetedUser.bio %></p>
      </div>

    </div>
    <% } else { %>
    <h1 id="profile-name">User not found</h1>
    <% } %>
  </main>

  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs") %>
</body>

</html>