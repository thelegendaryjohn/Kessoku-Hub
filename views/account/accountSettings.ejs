<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>
  <link rel="stylesheet" href="/css/account/menu.css">
  <link rel="stylesheet" href="/css/account/signIn.css">
  <link rel="stylesheet" href="/css/account/edit.css">
  <link rel="stylesheet" href="/css/account/settings.css">

  <title>Kessoku Hub | Edit Profile</title>
</head>

<body>
  <!-- Desktop nav bar partial -->
  <%- include("../partials/navBarDesktop.ejs") %>

  <!-- Sidebar partial -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "ACCOUNT" }) %>

  <!-- Cookies consent banner -->
  <%- include("../partials/popup/cookiesConsentPopup.ejs") %>

  <!-- Welcome page -->
  <main>
    <!-- Account settings functions -->
    <div id="menu-section-container">
      <!-- "Profile" section -->
      <section id="settings-section" class="menu-section">

        <form id="account-info-form" class="account-form" target="_self" data-user-id="<%= locals.user._id  %>">
          <h1 class="menu-section-title font-oswald">Verify Account</h1>

          <label id="email-label" class="form-label" for="email">Email</label>
          <div class="input-box">
            <input id="email-input" class="input-field" type="email" name="email" placeholder="guitarhero@kessoku.band" autocapitalize="off" autocomplete="new-password">

            <div class="input-function" id="verifyButton">
              <div class="verify-btn-container">
                <p class="verify-btn-text">Verify</p>
              </div>
            </div>
          </div>
          <span id="email-input-alert" class="alert">[Placeholder]</span>

          <span class="form-spacer"></span>
          <h1 class="menu-section-title font-oswald">Change Password</h1>

          <label id="password-signup-label" class="form-label" for="password">Old Password</label>
          <div class="input-box">
            <input id="old-password-input" class="input-field" type="password" name="password" placeholder="bocchitherock" autocapitalize="off" required>

            <div class="input-function pass-visibility">
              <img class="pass-visibility-img visible" src="/images/account-section/show-icon.svg" alt="Show/hide password">
            </div>
          </div>
          <span id="password-signup-alert" class="alert">[Placeholder]</span>

          <label id="password-signup-label" class="form-label" for="password">New Password</label>
          <div class="input-box">
            <input id="new-password-input" class="input-field" type="password" name="password" placeholder="bocchitherock" autocapitalize="off" autocomplete="new-password" name="new-password" required>

            <div class="input-function pass-visibility">
              <img class="pass-visibility-img visible" src="/images/account-section/show-icon.svg" alt="Show/hide password">
            </div>
          </div>
          <span id="password-signup-alert" class="alert">[Placeholder]</span>

          <label id="confirm-signup-label" class="form-label" for="confirm-password">Confirm New Password</label>
          <div class="input-box">
            <input id="confirm-password-input" class="input-field" type="password" name="confirm-password" placeholder="bocchitherock" autocapitalize="off" autocomplete="new-password" name="new-password-confirm" required>

            <div class="input-function pass-visibility">
              <img class="pass-visibility-img visible" src="/images/account-section/show-icon.svg" alt="Show/hide password">
            </div>
          </div>
          <span id="confirm-password-alert" class="alert">[Placeholder]</span>


          <input class="submit-btn" type="submit" value="Save Changes">
        </form>
      </section>
    </div>
  </main>
  <script src="/js/showHidePass.js"></script>
  <% if (locals.user.email) { %>
  <script>
    document.querySelector("#email-input").value = "<%= locals.user.email %>";
    document.querySelector("#email-input").disabled = true;
    document.querySelector("#verifyButton").style.display = "none";
  </script>
  <% } %>
  <script>
    // By default, hide all the alerts
    document.querySelectorAll(".alert").forEach((alert) => {
      alert.style.opacity = "0";
    });

    function errorAlert(element, content) {
      element.style.opacity = "1";
      element.textContent = content;
      setTimeout(() => {
        element.style.opacity = "0";
      }, 3000);
    }
    // Add an event listener to the verify button
    document.querySelector("#verifyButton").addEventListener("click", e => {
      const emailInput = document.querySelector("#email-input");
      // Verify the email input with regex
      if (!emailInput.value.match(/^[\w-\.]+@([\w-]+\.)+[\w-]{2,4}$/)) {
        errorAlert(document.querySelector("#email-input-alert"), "Please enter a valid email address.");
        return;
      }
      // If the email input is valid, send a request to the verify email route
      fetch("/api/account/verify", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            email: emailInput.value
          })
        })
        .then(res => {
          if (res.status === 200) {
            // If the email is sent, show a success alert
            const alert = document.querySelector("#email-input-alert");
            alert.classList.add("success");
            alert.textContent = "Email sent! Please verify within 5 minutes.";
            alert.style.opacity = "1";
            setTimeout(() => {
              alert.style.opacity = "0";
            }, 3000);
          } else {
            // If there is an error, show an error alert
            res.json().then(data => {
              errorAlert(document.querySelector("#email-input-alert"), data);
            });
          }
        })
        .catch(err => {
          // If there is an error, show an error alert
          errorAlert(document.querySelector("#email-input-alert"), "There was an error sending the email. Please try again later.");
        });
    })

    // Add an event listener to the form submission for password change
    document.querySelector("#account-info-form").addEventListener("submit", e => {
      e.preventDefault();

      const oldPasswordInput = document.querySelector("#old-password-input");
      const newPasswordInput = document.querySelector("#new-password-input");
      const confirmPasswordInput = document.querySelector("#confirm-password-input");

      const userId = document.querySelector("#account-info-form").dataset.userId;

      // Validate the new password and confirm password match
      if (newPasswordInput.value !== confirmPasswordInput.value) {
        errorAlert(document.querySelector("#confirm-password-alert"), "Passwords do not match.");
        return;
      }

      // Send a PUT request to the /user/password/:id endpoint
      fetch(`/user/password/${userId}`, {
          method: "PUT",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            oldPassword: oldPasswordInput.value,
            newPassword: newPasswordInput.value
          })
        })
        .then(res => {
          if (res.status === 200) {
            // If the password is successfully changed, show a success alert
            const alert = document.querySelector("#confirm-password-alert");
            alert.classList.add("success");
            alert.textContent = "Password successfully changed.";
            alert.style.opacity = "1";
            setTimeout(() => {
              alert.style.opacity = "0";
            }, 3000);
          } else {
            // If there is an error, show an error alert
            res.json().then(data => {
              console.log(data);
              errorAlert(document.querySelector("#confirm-password-alert"), data);
            });
          }
        })
        .catch(err => {
          // If there is an error, show an error alert
          errorAlert(document.querySelector("#confirm-password-alert"), "There was an error changing the password. Please try again later.");
        });
    });
  </script>
  </script>

  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs") %>
</body>

</html>