<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Success</title>
  <link rel="stylesheet" href="/css/account/success.css">
</head>

<body>
  <!-- Desktop nav bar partial -->
  <%- include("../partials/navBarDesktop.ejs") %>

  <!-- Sidebar partial -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "SUCCESS", headerColor: "var(--ryo-color)" }) %>

  <main id="success-container">
    <section id="success-section">
      <h1 id="success-title"><%- locals.message ? locals.message : "" %></h1>
      <div id="success-desc" class="loading-text-container">
        <span class="loading-text"></span>
      </div>
    </section>

    <!-- Escape plan if redirect doesn't work -->
    <div id="escape-plan">
      <p class="font-poppins">If redirection didn't start automatically, <a href="/" class="font-poppins">click here</a></p>
    </div>
  </main>
  <script>
    <% if (locals.redirect) { %>
    setTimeout(() => {
      window.location.href = "<%= locals.redirect %>";
    }, 1000);
    <% } else { %>
    setTimeout(() => {
      let params = new URL(document.location.toString()).searchParams;
      if (params.get("redirect")) {
        window.location.href = params.get("redirect");
      } else {
        window.history.go(-2);
      }
    }, 1000);
    <% } %>
  </script>
</body>

</html>