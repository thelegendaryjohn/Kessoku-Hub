<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>
  <link rel="stylesheet" href="/css/account/passForgot.css">

  <title>Kessoku Hub | Forget Password</title>
</head>

<body>
  <!-- Desktop nav bar partial -->
  <%- include("../partials/navBarDesktop.ejs") %>

  <!-- Sidebar partial -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "ACCOUNT" }) %>

  <!-- Cookies consent banner -->
  <%- include("../partials/popup/cookiesConsentPopup.ejs") %>

  <!-- Main content -->
  <main>

    <div id="content-section">
      <!-- Log in section -->
      <section class="account-section">
        <!-- Log in header -->
        <div class="section-header-container">
          <h1 class="section-header">Forgot Your Password?</h1>
        </div>

        <!-- Log in form -->
        <form id="forgot-pass-form" class="account-form" target="_self">
          <label for="email">Email</label>
          <div class="input-box">
            <input id="forgot-pass-input" class="input-field" type="email" name="email" placeholder="guitarhero@bocchi.rock" autocapitalize="off" required>
          </div>
          <!-- <span id="forgot-pass-alert" class="alert">[Placeholder]</span> -->

          <input class="submit-btn" type="submit" value="Reset Password">
        </form>
      </section>
      <h1 id="sent" style="display: none">If there was an account associated with that email, we will send you a reset password link.</h1>
    </div>

    <!-- Side image for desktop layout -->
    <div id="side-image-container">
      <img id="side-image" src="/images/general-images/desktop-side-image-2.webp" alt="Side image">
    </div>

  </main>

  <script>
    document.querySelector("#forgot-pass-form").addEventListener("submit", async (e) => {
      console.log("is this working?")
      e.preventDefault();
      const email = document.querySelector("#forgot-pass-input").value;
      const response = await fetch("/api/user/forget", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          email
        })
      });
      if (response) {
        document.querySelector("#forgot-pass-form").style.display = "none";
        document.querySelector(".section-header").style.display = "none";
        document.querySelector("#sent").style.display = "block";
      }
    });
  </script>
  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs") %>
</body>

</html>