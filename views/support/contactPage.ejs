<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>
  <link rel="stylesheet" href="/css/support/contact.css">

  <title>Kessoku Hub | Contact Us</title>
</head>

<body>
  <!-- Sidebar partial -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "CONTACT" }) %>

  <!-- Main content -->
  <main>
    <section id="content-section-container">
      <!-- Contact header -->
      <div id="contact-header">
        <h1 id="contact-title">Contact Us</h1>

        <!-- Contact description -->
        <p id="contact-desc" class="font-poppins">
          We greatly appreciate your feedback and inquiries, as they are essential to our continuous improvement and service. Kindly take a few moments to fill out the form below with your details and message, allowing us to address your needs effectively. Your effort in reaching out to us is highly valued, and we look forward to hearing from you.
        </p>
      </div>

      <!-- Contact form -->
      <form id="contact-form">
        <label for="contact-email-input" class="font-poppins">Email</label> 
        <input type="email" id="contact-email-input" class="input-field font-poppins" placeholder="Email" required>

        <label for="contact-subject-input" class="font-poppins">Subject</label>
        <input type="text" id="contact-subject-input" class="input-field font-poppins" placeholder="Subject" required>

        <textarea id="contact-message-input" class="input-field longtext-input-field font-poppins" placeholder="Your Message..." type="text" name="bio" placeholder="Write a comment..." oninput='this.style.height = "";this.style.height = this.scrollHeight + "px"'></textarea>

        <input id="contact-submit" class="form-btn" onclick="event.preventDefault();" type="submit" value="Send">
      </form>

    </section>
  </main>

  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs") %>
</body>

</html>