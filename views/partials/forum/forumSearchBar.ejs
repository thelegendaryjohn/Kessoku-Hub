<link rel="stylesheet" href="/css/forum/searchBar.css">

<div class="search-bar-container box-shadow">
  <div class="search-bar">
    <input class="search-input font-poppins" type="text" placeholder="Search" class="search-input">
    <img class="search-button" role="button" src="/images/forum-section/btn-search.svg" alt="Search">
  </div>

  <div class="filter-option-container">
    <p role="button" class="filter-option newest selected">Newest</p>
    <p role="button" class="filter-option oldest">Oldest</p>
  </div>
</div>

<script>
  // Write textContent from search bar to localStorage when pressing Search, the clear the search bar
  let historyCount = 0;

  document.querySelector(".search-button").addEventListener("click", () => {
    localStorage.setItem(`item_${historyCount}`, document.querySelector(".search-input").value);
    document.querySelector(".search-input").value = "";
    historyCount++;

    console.clear();
    console.log(`History count: ${historyCount}`);
    console.log(`Latest search: ${localStorage.getItem(`item_${historyCount - 1}`)}`);

    // Update #search-history-container with .search-history
    document.querySelector("#search-history-container").innerHTML += `<p class="search-history font-poppins">${localStorage.getItem(`item_${historyCount - 1}`)}</p>`;
  });
</script>