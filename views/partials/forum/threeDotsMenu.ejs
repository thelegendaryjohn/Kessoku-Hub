<link rel="stylesheet" href="/css/forum/threeDotsMenu.css">

<!-- three dots  menu container -->
<div class="three-dots-menu-container">
  <!-- three dots svg -->
  <svg class="three-dots-svg" xmlns="http://www.w3.org/2000/svg" width="2.5rem" height="3rem" viewBox="0 0 16 16" fill="#000000" class="bi bi-three-dots-vertical">
    <path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z" />
  </svg>
</div>
<!-- three dots menu -->
<div class="three-dots-menu">
  <a class="block-user three-dots-menu-button">Block User</a>
  <a class="share-user three-dots-menu-button">Share User</a>
</div>

<script>
  const threeDotsSvg = document.querySelector(".three-dots-svg");
  const threeDotsMenu = document.querySelector(".three-dots-menu");

  threeDotsSvg.addEventListener("click", (e) => {
    if (threeDotsMenu.style.display == "none") {
      threeDotsMenu.style.display = "flex";
    } else {
      threeDotsMenu.style.display = "none";
    }
  });
</script>