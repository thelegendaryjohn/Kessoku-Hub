		l-99.357,98.675C149.841,257.159,149.823,257.142,149.823,257.142z" />
          </g>
        </svg>
      </label>
    </div>
    <input id="post-create-attachments" type="file" class="form-btn" value="Upload Image" name="attachment" accept="image/*">
  </form>
</div>

<script>
  const commentInput = document.querySelector("#comment-post-input");
  const commentBox = document.querySelector("#comment-section-fixed-box");
  const commentSubmit = document.querySelector("#submit-button");
  const attachmentInput = document.querySelector("#post-create-attachments");
  let isDisabled = true;

  commentSubmit.addEventListener("mouseover", () => {
    if (!isDisabled) {
      commentSubmit.style.cursor = "pointer";
      commentSubmit.style.opacity = "0.7";
    } else {
      commentSubmit.style.cursor = "default";
    }
  })

  commentSubmit.addEventListener("mouseout", () => {
    if (!isDisabled) {
      commentSubmit.style.opacity = "1";
    }
  })

  commentInput.addEventListener("input", () => {
    if (commentInput.value === "") {
      commentSubmit.style.stroke = "var(--accent-lightgrey)"
      isDisabled = true;
    } else {
      commentSubmit.style.stroke = "#2254C0";
      isDisabled = false;
    }
    commentInput.style.height = "";
    commentInput.style.height = commentInput.scrollHeight + "px";
    document.querySelector("main").style.marginBottom = commentBox.offsetHeight + "px";
  })

  attachmentInput.addEventListener("change", () => {
    if (attachmentInput.files.length > 0)
      document.querySelector("#attachment-name").textContent = attachmentInput.files[0].name;
    document.querySelector("#attachment-container").style.display = "flex";
  })

  document.querySelector("#attachment-remove").addEventListener("click", () => {
    attachmentInput.value = "";
    document.querySelector("#attachment-name").textContent = "";
    document.querySelector("#attachment-container").style.display = "none";
  })
</script>