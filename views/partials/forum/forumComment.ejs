<div class="topic">
  <!-- topic header -->
  <div class="topic-header">
    <a href="<%= `/user/${post.author._id}` %>">
      <div class="topic-header-date-title">
        <h3 class="topic-title"><%= locals.authorName %></h3>
        <h4 class="topic-date"><%= locals.commentDate %></h4>
      </div>
    </a>
  </div>

  <!-- Comment content -->
  <div class="topic-content">
    <!-- Post link container -->
    <div class="post-link-container">
      <!-- Post link -->
      <div class="post-container">
        <!-- Post link text -->
        <p class="post-title"><%= locals.commentText %></p>
        <!-- topic post status -->
        <div class="topic-post-link-status">
          <!-- Likes -->
          <span class="status-likes status-container">
            <img class="status-icon" src="/images/forum-section/heart-icon.svg" alt="Likes">
            <p><%= locals.likes %></p>
          </span>
        </div>
      </div>
    </div>
  </div>

</div>