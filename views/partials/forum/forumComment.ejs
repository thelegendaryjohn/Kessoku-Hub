<div class="thread">
  <!-- Thread header -->
  <div class="thread-header">
    <a href="#">
      <div class="thread-header-date-title">
        <h3 class="thread-title"><%= locals.authorName %></h3>
        <h4 class="thread-date"><%= locals.commentDate %></h4>
      </div>
    </a>
  </div>

  <!-- Comment content -->
  <div class="thread-content">
    <!-- Post link container -->
    <div class="post-link-container">
      <!-- Post link -->
      <div class="post-container">
        <!-- Post link text -->
        <p class="post-title"><%= locals.commentText %></p>
        <!-- Thread post status -->
        <div class="thread-post-link-status">
          <!-- Likes -->
          <span class="status-likes status-container">
            <img class="status-icon" src="/images/forum-section/heart-icon.svg" alt="Likes">
            <p><%= locals.likes %></p>
          </span>
        </div>
      </div>
    </div>
  </div>

</div>