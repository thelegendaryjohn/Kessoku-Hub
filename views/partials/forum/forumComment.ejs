<div class="topic">
  <!-- topic header -->
  <div class="topic-header">
    <a href="<%= `/api/user/${comment.author.username}` %>">
      <div class="topic-header-date-title">
        <img src='<%= comment.author.avatar != "" ? `/${comment.author.avatar}` : "/images/account-section/user-icon.svg"%>' alt="User avatar" class="topic-avatar">
        <h3 class="topic-author"><%= comment.author.username %></h3>
        <h4 class="topic-date"><%- include("./forumDate.ejs", {obj: comment}) %></h4>
      </div>
    </a>
    <%- include("threeDotsMenuComment.ejs", {isComment: true}) %>
  </div>

  <!-- Comment content -->
  <div class="topic-content">
    <!-- Post link container -->
    <div class="post-link-container">
      <!-- Post link -->
      <div class="post-container">
        <!-- Post link text -->
        <textarea title="post content" placeholder="this post has no text" class="post-content-text font-poppins"><%= comment.content %></textarea>
        <% if (comment.attachment) { %>
        <img src="/<%= comment.attachment %>" alt="Post image" class="post-image">
        <% } %>
        <div class="post-edit-container hide">
          <button class="edit-cancel-btn post-edit-btn">Cancel</button>
          <button class="edit-submit-btn post-edit-btn">Done</button>
        </div>
        <!-- topic post status -->
        <div class="topic-post-link-status">
          <!-- Likes -->
          <button class="status-likes status-container">
            <img class="status-icon" src="/images/forum-section/heart-icon.svg" alt="Likes">
            <p><%= comment.likes.length %></p>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>