<style>
  /* Add margin to main */
  main {
    margin-bottom: 5rem;
  }
</style>

<section id="forum-action-container" class="box-shadow-reverse">
  <!-- Home button -->
  <a href="/forum">
    <div class="forum-action-btn-container">
      <img class="forum-action-btn-img" src="/images/forum-section/btn-home.svg" alt="Home">
      <div class="forum-action-btn-text">Home</div>
    </div>
  </a>

  <!-- Post button -->
  <a href="/forum/post/create">
    <div class="forum-action-btn-container">
      <img class="forum-action-btn-img" src="/images/forum-section/btn-add.svg" alt="Post">
      <div class="forum-action-btn-text">Post</div>
    </div>
  </a>

  <!-- Profile button -->
  <% if (locals.user) { %>
  <a href="/api/user/<%= locals.user.username %>">
    <% } else { %>
    <a href="/account">
      <% } %>
      <div class="forum-action-btn-container">
        <img class="forum-action-btn-img" src="/images/forum-section/btn-profile.svg" alt="Profile">
        <div class="forum-action-btn-text">Profile</div>
      </div>
    </a>

    <script src="/js/forum/forumAction.js"></script>

</section>