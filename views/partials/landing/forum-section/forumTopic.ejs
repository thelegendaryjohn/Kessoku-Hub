<div class="topic">
  <!-- topic header -->
  <div class="topic-header">
    <a href="/forum/topic/<%= topic.name %>">
      <div class="thread-header-date-title">
        <h3 class="thread-title"><%= topic.name %></h3>
      </div>
    </a>
  </div>

  <!-- topic content -->
  <div class="topic-content">
    <!-- Post link container -->
    <% if (locals.isPost) { %>
    <%- include("postContainer.ejs", {
      post: post,
    }) %>
    <% } else { %>
    <% Object.values(posts[topic._id]).map((post) => { %>
    <%- include("postContainer.ejs", {
      post: post,
    }) %>
    <% }); %>
    <% } %>
  </div>
</div>