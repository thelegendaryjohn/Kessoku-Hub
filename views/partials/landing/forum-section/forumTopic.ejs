<div class="thread">
  <!-- Thread header -->
  <div class="thread-header">
    <a href="/forum/thread?thread=<%= locals.threadTitle %>">
      <div class="thread-header-date-title">
        <h3 class="thread-title"><%= locals.threadTitle %></h3>
        <h4 class="thread-date" style="display:<%= (locals.showDate) === true ? 'block' : 'none' %>;"><%= locals.threadDate %></h4>
      </div>

      <div class="thread-status" style="display:<%= (locals.showThreadStatus) === true ? 'block' : 'none' %>;">
        <%- include("forumStatus.ejs", {
          status: locals.threadStatus
        }) %>
      </div>
    </a>
  </div>

  <!-- Thread content -->
  <div class="thread-content">
    <!-- Post link container -->
    <% if (locals.isPost) { %>
    <%- include("postContainer.ejs", {
      post: locals.threadPosts,
    }) %>
    <% } else { %>
    <% locals.threadPosts.forEach((p, i) => { %>
    <%- include("postContainer.ejs", {
      post: locals.threadPosts[i],
    }) %>
    <% }); %>
    <% } %>
  </div>
</div>