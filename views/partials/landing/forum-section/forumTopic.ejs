<div class="topic">
  <!-- topic header -->
  <div class="topic-header">
    <a href="/forum/topic/<%= topic.name %>">
    </a>
  </div>

  <!-- topic content -->
  <div class="topic-content">
    <!-- Post link container -->
    <% if (locals.isPost) { %>
    <%- include("postContainer.ejs", {
      post: post,
    }) %>
    <% } else { %>
    <% Object.entries(posts).map((topicId, post) => { %>
    <%- include("postContainer.ejs", {
      post: post,
    }) %>
    <% }); %>
    <% } %>
  </div>
</div>