<section id="forum" class="box-shadow">
  <h2 id="forum-header" class="section-header">FORUM</h2>
  <div id="topic-container" class="section-container">
    <% topics.forEach((topic) => { %>
    <%- include("../../forum/forumTopic.ejs", { 
            topic: topic,
            posts: posts[topic._id],
          }) %>
    <% }); %>
  </div>

  <a href="/forum" class="see-all-anchor">See all...</a>
</section>