<section id="forum" class="box-shadow">
  <a class="header-anchor" href="/forum"><h2 id="forum-header" class="section-header">FORUM</h2></a>
  <div id="thread-container" class="section-container">
    <% thread.forEach((t, i) => { %>
    <%- include("forumThread.ejs", { 
        threadTitle: thread[i].threadTitle,
        threadPosts: thread[i].threadPosts,
        threadStatus: thread[i].threadStatus,
      }) %>
    <% }); %>
  </div>

  <a href="#" class="see-all-anchor">See all...</a>
</section>