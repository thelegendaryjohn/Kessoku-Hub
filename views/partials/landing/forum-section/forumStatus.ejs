<!-- Thread post status -->
<div class="thread-post-link-status">
  <!-- Views -->
  <span class="status-views status-container">
    <img class="status-icon" src="/images/forum-section/view-icon.svg" alt="Views">
    <p><%= locals.views %></p>
  </span>

  <!-- Comments -->
  <span class="status-comments status-container">
    <img class="status-icon" src="/images/forum-section/comment-icon.svg" alt="Comments">
    <p><%= locals.comments %></p>
  </span>

  <!-- Likes -->
  <span class="status-likes status-container">
    <img class="status-icon" src="/images/forum-section/heart-icon.svg" alt="Likes">
    <p><%= locals.likes %></p>
  </span>
</div>