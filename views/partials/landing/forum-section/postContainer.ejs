<a class="post-link-container" href="/forum/thread">
  <!-- Post link -->
  <%- include("threadPost.ejs", {
    title: locals.post.postTitle,
    status: locals.post.postStatus,
  }) %>

  <!-- Post link arrow -->
  <img class="post-link-arrow" style="display:<%= (locals.isPost) === true ? 'none' : 'block' %>;" src="/images/button/btn-next.svg" alt="Go to thread">
</a>