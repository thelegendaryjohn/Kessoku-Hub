<div class="thread">
  <!-- Thread header -->
  <div class="thread-header">
    <a href="#">
      <h3 class="thread-title"><%= locals.threadTitle %></h3>
    </a>
  </div>

  <!-- Thread content -->
  <div class="thread-content">
    <!-- Post link container -->
    <% locals.threadPosts.forEach((p, i) => { %>
    <%- include("postContainer.ejs", {
      post: locals.threadPosts[i],
    }) %>
    <% }); %>
  </div>
</div>