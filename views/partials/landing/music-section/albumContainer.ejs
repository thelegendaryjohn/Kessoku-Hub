<section id="music" class="box-shadow">
  <a class="header-anchor" href="/music">
    <h2 id="music-header" class="section-header">MUSIC</h2>
  </a>
  <div id="album-container" class="section-container">
    <%- include("albumHeader.ejs") %>

    <div id="album-song-list">
      <% for(let i = 0; i < 4; i++) { %>
        <%- include("./albumSong.ejs", {
              index: songs[i].index,
              name: songs[i].songName,
              length: songs[i].length,
              url: songs[i].preview_url,
            }) %>
      <% }; %>
    </div>

    <%- include("../../music/audioWidget.ejs") %>
  </div>


  <script src="/js/landing/music-section/songSelection.js"></script>

  <a href="/music" class="see-all-anchor">See all...</a>
</section>