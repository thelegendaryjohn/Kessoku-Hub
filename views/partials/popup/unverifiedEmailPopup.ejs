<link rel="stylesheet" href="/css/popup/email.css">

<div class="email-popup box-shadow" style="display: <%= locals.isVisible ? "flex" : "none" %>;">
  <svg class="email-popup-close" role="button" aria-label="Close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10" stroke="#000" stroke-width="1" fill="rgba(0,0,0,0)" stroke-linecap="round" style="cursor: pointer">
    <path d="M3,3L5,5L7,3M5,5L5,5M3,7L5,5L7,7"></path>
  </svg>
  <p class="email-popup-text font-poppins">Please verify your email <a class="font-poppins" href="/account/settings">here</a> before you can post.</p>
  <!-- <button class="email-popup-ok">OK</button> -->

  <script>
    document.querySelector(".email-popup-close").addEventListener("click", () => {
      document.querySelector(".email-popup").style.display = "none";
    });
  </script>
</div>