<!-- Sidebar -->
<nav id="sidebar" class="sidebar ignoreSidebarToggle">
  <div id="sidebar-container">
    <a href="<%= user ? "/account/profile" : "/account" %>">
      <div id="profile-container">
        <img src="/images/account-section/user-icon.svg" alt="User profile icon" id="profile-img">
        <h1 id="profile-name"><%= 
          user ? user.username : "Guest"
          %></h1>
      </div>
    </a>
    <div id="nav-buttons">
      <a id="nav-top" class="btn nav-btn" href="/">TOP</a>
      <a id="nav-forum" class="btn nav-btn" href="/">FORUM</a>
      <a id="nav-series" class="btn nav-btn" href="/">THE SERIES</a>
      <a id="nav-music" class="btn nav-btn" href="/">MUSIC</a>
      <a id="nav-store" class="btn nav-btn" href="/">STORE</a>
      <!-- <a id="nav-create-account" class="btn nav-btn" href="#">CREATE ACCOUNT</a> -->
      <div class="divider"></div>
      <a id="nav-login" class="btn nav-btn" href="<%= user ? "/account/logout" : "/account" %>">
        <%= user ? "LOG OUT" : "LOG IN / CREATE ACCOUNT"%>
      </a>
    </div>
  </div>
</nav>
<!-- Sidebar button -->
<svg id="menu-btn" class="btn ignoreSidebarToggle" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10" stroke="#C45AFF" stroke-width=".25" fill="rgba(0,0,0,0)" stroke-linecap="round" style="cursor: pointer">
  <path d="M2,3L5,3L8,3M2,5L8,5M2,7L5,7L8,7" stroke="#C45AFF" id="menu-btn-path">
    <animate dur="0.2s" attributeName="d" values="M2,3L5,3L8,3M2,5L8,5M2,7L5,7L8,7;M3,3L5,5L7,3M5,5L5,5M3,7L5,5L7,7" fill="freeze" begin="start.begin" />
    <animate dur="0.2s" attributeName="d" values="M3,3L5,5L7,3M5,5L5,5M3,7L5,5L7,7;M2,3L5,3L8,3M2,5L8,5M2,7L5,7L8,7" fill="freeze" begin="reverse.begin" />
  </path>
  <rect width="10" height="10" stroke="none">
    <animate dur="2s" id="reverse" attributeName="width" begin="" />
  </rect>
  <rect width="10" height="10" stroke="none">
    <animate dur="0.001s" id="start" attributeName="width" values="10;0" fill="freeze" begin="" />
    <animate dur="0.001s" attributeName="width" values="0;10" fill="freeze" begin="reverse.begin" />
  </rect>
</svg>

<!-- Script -->
<script src="/js/sidebar.js"></script>