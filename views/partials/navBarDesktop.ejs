<style>
  #desktop-nav-container a {
    text-decoration: none;
  }

  #desktop-user-profile-container {
    position: relative;
  }

  #desktop-user-profile-container #profile-img {
    width: 5em;
  }

  .hide {
    display: none !important;
  }

  .user-profile-menu-container {
    display: flex;
    font-size: 1.5rem;
    flex-direction: column;
    position: absolute;
    background-color: var(--body-color);
    box-shadow: 0 0.4rem 0.4rem rgba(0, 0, 0, 0.2);
    border-radius: 5px;
    width: 100%;
    max-width: 10rem;
    gap: 0.2rem;
    top: 6rem;
    right: 0;
  }

  .user-profile-menu-btn {
    display: flex;
    box-sizing: border-box;
    padding: 0.5rem;
    width: 100%;
    border-radius: 5px;
    color: var(--black-color);
  }

  .user-profile-menu-btn:hover {
    transition: 0.12s;
    background-color: var(--ryo-color);
    color: var(--body-color);
  }


  /* dark mode slider settings */
  .theme-toggle-container {
    display: flex;
    gap: 0.5rem;
  }

  /* The switch - the box around the slider */
  .switch {
    position: relative;
    display: inline-block;
    height: 2rem;
    width: 3.5rem;
  }

  /* Hide default HTML checkbox */
  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  /* The slider */
  .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--body-color);
    -webkit-transition: 0.4s;
    transition: 0.4s;
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 1.5rem;
    width: 1.5rem;
    left: 0.3rem;
    bottom: 0.25rem;
    background-color: var(--black-color);
    -webkit-transition: 0.4s;
    transition: 0.4s;
  }

  input:checked+.slider {
    background-color: var(--body-color);
  }

  input:focus+.slider {
    box-shadow: 0 0 1px var(--black-color);
  }

  input:checked+.slider:before {
    -webkit-transform: translateX(1.5rem);
    -ms-transform: translateX(1.5rem);
    transform: translateX(1.5rem);
    background-color: var(--black-color);
  }

  /* Rounded sliders */
  .slider.round {
    border-radius: 1rem;
  }

  .slider.round:before {
    border-radius: 50%;
  }
</style>

