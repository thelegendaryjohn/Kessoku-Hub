<style>
  /* dark mode slider settings */
  /* The switch - the box around the slider */
  .switch {
    position: relative;
    display: inline-block;
    height: 2rem;
    width: 5rem;
  }

  /* Hide default HTML checkbox */
  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  /* The slider */
  .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--body-color);
    -webkit-transition: 0.4s;
    transition: 0.4s;
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 1.5rem;
    width: 1.5rem;
    left: 0.3rem;
    bottom: 0.2rem;
    background-color: var(--black-color);
    -webkit-transition: 0.4s;
    transition: 0.4s;
  }

  input:checked+.slider {
    background-color: var(--body-color);
  }

  input:focus+.slider {
    box-shadow: 0 0 1px var(--black-color);
  }

  input:checked+.slider:before {
    -webkit-transform: translateX(3rem);
    -ms-transform: translateX(3rem);
    transform: translateX(3rem);
    background-color: var(--black-color);
  }

  /* Rounded sliders */
  .slider.round {
    border-radius: 1rem;
  }

  .slider.round:before {
    border-radius: 50%;
  }
</style>

<!-- dark mode switch -->
<label class="switch">
  <input id="colorCheckBox" type="checkbox">
  <span class="slider round"></span>
</label>

<script>
  var root = document.documentElement;
  const slider = document.querySelector(".slider");
  let initializeTheme = localStorage.getItem("colorTheme");

  if (initializeTheme == "dark") {
    document.getElementById("colorCheckBox").checked = true;
  }

  slider.addEventListener("click", (e) => {
    let currentTheme = localStorage.getItem("colorTheme");
    if (currentTheme == "dark") {
      localStorage.setItem("colorTheme", "light");
      root.style.setProperty('--body-color', '#ffffff');
      root.style.setProperty('--black-color', '#000000');
    } else {
      localStorage.setItem("colorTheme", "dark");
      root.style.setProperty('--body-color', '#000000');
      root.style.setProperty('--black-color', '#ffffff');
    }
  });
</script>