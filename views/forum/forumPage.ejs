<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Forum</title>
  <link rel="stylesheet" href="/css/forum/main.css">
  <link rel="stylesheet" href="/css/forum/forum.css">
  <link rel="stylesheet" href="/css/landing/forum.css">
</head>

<body>
  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "FORUM", headerColor: "var(--accent-purple)" }) %>

  <!-- Main content -->
  <main>
    <!-- Thread functions partial -->
    <%- include("../partials/forum/threadAction.ejs") %>

    <!-- Topic section -->
    <section id="content-section-container">
      <% const numTopics = 7; %>
      <% for (let i = 0; i < numTopics; i++) { %>
      <%- include("../partials/landing/forum-section/forumTopic.ejs") %>
      <% } %>
    </section>
  </main>

  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs") %>
</body>

</html>