<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Forum</title>
  <link rel="stylesheet" href="/css/forum/forum.css">
  <link rel="stylesheet" href="/css/forum/main.css">
  <link rel="stylesheet" href="/css/forum/post.css">
</head>

<body>
  <!-- Desktop nav bar partial -->
  <%- include("../partials/navBarDesktop.ejs", {
    selected: "FORUM",
  }) %>

  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: post.topicId.name, headerColor: "var(--accent-purple)", linkedNav: true }) %>

  <!-- Cookies consent banner -->
  <%- include("../partials/popup/cookiesConsentPopup.ejs") %>

  <!-- Main content -->
  <main>
    <!-- Thread section -->
    <section id="content-section-container">
      <div id="post-section">
        <div id="post-title" style="word-break: break-all; white-space: normal;">
          <%- include("../partials/forum/forumPostTitle.ejs") %>
        </div>

        <div id="post-content">
          <textarea title="post content" placeholder="this post has no text" class="post-content-text font-poppins"><%= post.content %></textarea>
          <% if (post.attachment) { %>
          <img src="/<%= post.attachment %>" alt="Post image" class="post-content-image">
          <% } %>
          <div class="post-edit-container hide">
            <button class="edit-cancel-btn post-edit-btn">Cancel</button>
            <button class="edit-submit-btn post-edit-btn">Done</button>
          </div>
        </div>
      </div>

      <div class="section-divider"></div>

      <div id="comment-section">

        <% comments.forEach(comment => { %>
        <%- include("../partials/forum/forumComment.ejs", { comment: comment }) %>
        <% }) %>

      </div>

    </section>

    <!-- Comment box partial -->
    <%- include("../partials/forum/commentBox.ejs") %>

    <!-- Footer partial -->
    <%- include("../partials/htmlFooter.ejs", { hideFooter: true }) %>
    <!-- Comment three dot menu script -->
    <script>
      document.querySelectorAll(".comment-three-dots-menu").forEach((container) => {
        const threeDotsMenuButton = container.querySelector(".three-dots-menu-container");
        const threeDotsMenu = container.querySelector(".three-dots-menu");
        let commentId = container.getAttribute("data-comment-id");

        // If three-dots-menu does not contain any children, hide the three-dots-menu-container
        if (threeDotsMenu.children.length === 0) {
          threeDotsMenuButton.classList.add("hide");
        }

        threeDotsMenuButton.addEventListener("click", (e) => {
          threeDotsMenu.classList.toggle("hide");
        });

        // Implement the three-dots-menu actions
        function performAction(actionName) {
          let url = "";
          let method = "PUT";
          switch (actionName) {
            case "delete": {
              method = "DELETE";
              url = "/thread/comment";
              url += `/${commentId}`;
              break;
            }
            case "edit": {
              method = "PUT";
              url = "/thread/comment";
              url += `/${commentId}`;
              break;
            }
          }

          fetch(url, {
              method: method,
              headers: {
                "Content-Type": "application/json"
              }
            })
            .then((res) => {
              if (res.status === 200) {
                window.location.reload();
              }
            })
            .catch((err) => {
              console.log(err);
            });
        }

        function addEventListenerIfExists(selector, event, handler) {
          const element = container.querySelector(selector);
          if (element) {
            element.addEventListener(event, handler);
          }
        }
        // Delete post
        addEventListenerIfExists("#deleteComment", "click", () => {
          performAction("delete");
        });

        // Edit post
        addEventListenerIfExists("#editComment", "click", () => {
          performAction("edit");
        });
      })
    </script>
  </main>

</body>
<script>
  document.querySelector(".post-content-text").disabled = true;
  const postText = document.querySelector(".post-content-text");
  const editContainer = document.querySelector(".post-edit-container");
  const postEditBtn = document.querySelectorAll(".post-edit-btn");
  const editBtn = document.getElementById("authorEditPost");

  try {
    editBtn.addEventListener("click", () => {
      document.querySelector(".post-content-text").disabled = false;
      editContainer.classList.remove("hide");
    })
  } catch (err) {
    console.log("you have not login");
  }

  postEditBtn.forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelector(".post-content-text").disabled = true;
      editContainer.classList.add("hide");
    })
  });
</script>

</html>