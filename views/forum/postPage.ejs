<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Forum</title>
  <link rel="stylesheet" href="/css/forum/forum.css">
  <link rel="stylesheet" href="/css/forum/main.css">
  <link rel="stylesheet" href="/css/forum/post.css">
</head>

<body>
  <!-- Desktop nav bar partial -->
  <%- include("../partials/navBarDesktop.ejs", {
    selected: "FORUM",
  }) %>

  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: post.topicId.name, headerColor: "var(--accent-purple)", linkedNav: true }) %>

  <!-- Cookies consent banner -->
  <%- include("../partials/popup/cookiesConsentPopup.ejs") %>

  <!-- Main content -->
  <main>
    <!-- Thread section -->
    <section id="content-section-container">
      <div id="post-section">
        <div id="post-title">
          <%- include("../partials/forum/forumPostTitle.ejs") %>
        </div>

        <div id="post-content">
          <p class="post-content-text font-poppins"><%= post.content %></p>
        </div>
      </div>

      <div class="section-divider"></div>

      <div id="comment-section">

        <% comments.forEach(comment => { %>
        <%- include("../partials/forum/forumComment.ejs", { comment: comment }) %>
        <% }) %>

      </div>

    </section>

    <!-- Comment box partial -->
    <%- include("../partials/forum/commentBox.ejs") %>
  </main>


  <!-- Footer partial -->
  <%- include("../partials/htmlFooter.ejs", { hideFooter: true }) %>

  <script>
    // Posting a comment
    document.querySelector("#comment-post-submit").addEventListener("click", async (e) => {
      e.preventDefault();

      if (document.querySelector("#comment-post-input").value) {
        const content = document.querySelector("#comment-post-input").value;
        const postId = "<%= post._id %>";

        const response = await fetch(`/thread/comment/`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            postId: postId,
            content: content,
          }),
        });

        if (response.ok) {
          window.location.reload();
        } else {
          response.json().then((data) => {
            console.log(data);
            alert("Failed to create comment: " + data);
          });
        }
      }
    });
  </script>
</body>

</html>