<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Forum</title>
  <link rel="stylesheet" href="/css/forum/forum.css">
  <link rel="stylesheet" href="/css/forum/main.css">
  <link rel="stylesheet" href="/css/forum/post.css">
</head>

<body>

  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: post.topicId.name, headerColor: "var(--accent-purple)" }) %>

  <!-- Main content -->
  <main>
    <!-- Thread section -->
    <section id="content-section-container">
      <div id="post-section">
        <div id="post-title">
          <%- include("../partials/forum/forumPostTitle.ejs") %>
        </div>

        <div id="post-content">
          <p class="post-content-text font-poppins"><%= post.content %></p>
        </div>
      </div>

      <div class="section-divider"></div>

      <div id="comment-section">
        <div id="comment-section-sticky-box">
          <!-- Comment posting -->
          <form id="comment-post-container" class="form-container box-shadow">
            <textarea id="comment-post-input" class="input-field longtext-input-field font-poppins" type="text" name="bio" placeholder="Write a comment..." autocomplete="off" oninput='this.style.height = "";this.style.height = this.scrollHeight + "px"'></textarea>
            <div id="comment-post-btn-container">
              <button id="comment-post-cancel" class="form-btn comment-post-btn">Cancel</button>
              <input id="comment-post-submit" class="form-btn comment-post-btn" type="submit" value="Post" onclick="event.preventDefault();">
            </div>
          </form>
        </div>

        <% comments.forEach(comment => { %>
        <%- include("../partials/forum/forumComment.ejs", { comment: comment }) %>
        <% }) %>

      </div>

    </section>
  </main>

  <!-- Forum actions partial -->
  <%- include("../partials/forum/forumAction.ejs") %>

  <script>
    // Posting a comment
    document.querySelector("#comment-post-submit").addEventListener("click", async (e) => {
      e.preventDefault();

      const content = document.querySelector("#comment-post-input").value;
      const postId = "<%= post._id %>";

      const response = await fetch(`/thread/comment/`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          postId: postId,
          content: content,
        }),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        response.json().then((data) => {
          console.log(data);
          alert("Failed to create comment: " + data);
        });
      }
    });
  </script>
</body>

</html>