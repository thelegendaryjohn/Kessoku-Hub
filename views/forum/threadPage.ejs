<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Forum</title>
  <link rel="stylesheet" href="/css/landing/forum.css">
  <link rel="stylesheet" href="/css/forum/main.css">
  <link rel="stylesheet" href="/css/forum/thread.css">
</head>

<body>
  <% const threadName = "THIS IS TOPIC 1"; %>

  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: threadName, headerColor: "var(--accent-purple)" }) %>

  <!-- Main content -->
  <main>
    <!-- Post section -->
    <section id="content-section-container">
      <% const numPost = 14; %>
      <% for (let i = 0; i < numPost; i++) { %>
      <%- include("../partials/landing/forum-section/forumThread.ejs") %>
      <% } %>
    </section>
  </main>

  <!-- Forum action partial -->
  <%- include("../partials/forum/forumAction.ejs") %>
</body>

</html>