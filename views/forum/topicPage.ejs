<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Forum</title>
  <link rel="stylesheet" href="/css/landing/forum.css">
  <link rel="stylesheet" href="/css/forum/main.css">
  <link rel="stylesheet" href="/css/forum/topic.css">
</head>

<body>
  <% const topicName = "THIS IS TOPIC 1"; %>

  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: topicName, headerColor: "var(--accent-purple)" }) %>

  <!-- Main content -->
  <main>
    <!-- Post section -->
    <section id="content-section-container">
      <% topic.forEach((t, i) => { %>
      <%- include("../partials/landing/forum-section/forumTopic.ejs", { 
            showDate: true,
            showtopicStatus: false,
            topicTitle: topic[i].topicTitle,
            topicPosts: topic[i].topicPosts,
            //topicStatus: topic[i].topicStatus,
            //topicDate: topic[i].topicDate,
          }) %>
      <% }); %>
    </section>
  </main>

  <!-- Forum action partial -->
  <%- include("../partials/forum/forumAction.ejs") %>
</body>

</html>