<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>
  <link rel="stylesheet" href="/css/forum/welcome.css">

  <title>Kessoku Hub | Account</title>
</head>

<body>
  <!-- Desktop nav bar partial -->
  <%- include("../partials/navBarDesktop.ejs", {
    selected: "FORUM",
  }) %>

  <!-- Sidebar partial -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "ACCOUNT" }) %>

  <!-- Cookies consent banner -->
  <%- include("../partials/popup/cookiesConsentPopup.ejs") %>

  <!-- Welcome page -->
  <main>
    <!-- Main content container -->
    <div id="welcome-container">
      <!-- Logo -->
      <div id="logo-container">
        <img src="/images/top-section/band-logo.svg" alt="Kessoku band logo" id="logo">
      </div>

      <!-- Welcome text container -->
      <div id="text-container">
        <h1 id="welcome-header">Join Our Forum</h1>
        <h2 id="welcome-text">Join our forum to engage in discussions about the series and connect with others who shares your interests.</h1>
      </div>

      <!-- Account option buttons -->
      <div id="option-btn-container">
        <div id="login-btn">
          <a href="/account?redirect=/forum">Log In or Sign Up</a>
        </div>

        <!-- <div id="signup-btn">
          <a href="/account">Create an account</a>
        </div> -->
      </div>
    </div>
  </main>

</body>

</html>