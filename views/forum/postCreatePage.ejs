<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Forum</title>
  <link rel="stylesheet" href="/css/forum/forum.css">
  <link rel="stylesheet" href="/css/forum/main.css">
  <link rel="stylesheet" href="/css/forum/create.css">
</head>

<body>
  <!-- Desktop nav bar partial -->
  <%- include("../partials/navBarDesktop.ejs", {
    selected: "FORUM",
  }) %>

  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "FORUM", headerColor: "var(--accent-purple)" }) %>

  <!-- Unverified email popup partial -->
  <% console.log(isVerified); %>
  <%- include("../partials/popup/unverifiedEmailPopup.ejs", { isVisible: !isVerified }) %>

  <!-- Cookies consent banner -->
  <%- include("../partials/popup/cookiesConsentPopup.ejs") %>

  <!-- Main content -->
  <main>
    <!-- Thread select datalist -->

    <!-- Thread section -->
    <section id="content-section-container">
      <!-- Post creating header -->
      <div id="post-create-header" class="section-header">
        <h2 id="post-create-header-text" class="section-header-text text-shadow">Create A Post</h2>
      </div>

      <!-- Post creating -->
      <form id="post-create-container" class="form-container">
        <div id="post-create-option-container">
          <label for="post-create-option-thread-select" class="font-poppins">Topics</label>
          <select id="post-create-option-thread-select" class="input-field font-poppins" type="text" list="thread-list" default="Select a topic!">
            <% topics.forEach((topic) => { %>
            <% if (topic.allowedRole <= user.role) { %>
            <option value=<%= topic.name %> id=<%= topic._id %>><%= topic.name %> </option>
            <% } %>
            <% }) %>
          </select>

          <label for="post-create-option-title" class="font-poppins">Title</label>
          <input id="post-create-option-title" class="input-field font-poppins" type="text" name="bio" placeholder="Make sure it's at least 5 characters!">
        </div>

        <textarea id="post-create-input" class="longtext-input-field input-field font-poppins" type="text" name="bio" placeholder="Write the content..." autocomplete="off" oninput='this.style.height = "";this.style.height = this.scrollHeight + "px"'></textarea>

        <div id="post-create-btn-container" style="display: <%= locals.user.isRestricted ? "none" : "flex" %>;">
          <button id="post-create-attachments" class="form-btn" onclick="event.preventDefault();">Add Files</button>
          <input id="post-create-submit" class="form-btn" type="submit" value="Post" onclick="event.preventDefault();">
        </div>

        <div id="post-create-restricted">
          <p class="font-poppins" id="post-create-restricted-text">You are restricted from the forum</p>
        </div>
      </form>

    </section>
  </main>

  <!-- Forum actions partial -->
  <%- include("../partials/forum/forumAction.ejs") %>

  <script>
    // Upon form submission, send a POST request to the server to create a new post
    document.getElementById("post-create-submit").addEventListener("click", async (event) => {
      event.preventDefault();

      const threadSelect = document.getElementById("post-create-option-thread-select");
      const titleInput = document.getElementById("post-create-option-title");
      const contentInput = document.getElementById("post-create-input");

      const threadId = threadSelect.options[threadSelect.selectedIndex].id;
      const title = titleInput.value;
      const content = contentInput.value;

      const response = await fetch("/thread/post", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          topic: threadId,
          title: title,
          content: content,
        }),
      });

      if (response.ok) {
        response.json().then((data) => {
          window.location.href = `/forum/thread/${data._id}`;
        });
      } else {
        response.json().then((data) => {
          alert("Failed to create post: " + data);
        });
      }
    });
  </script>
</body>

</html>