<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Head partial -->
  <%- include("../partials/htmlHead.ejs") %>

  <title>Kessoku Hub | Forum</title>
  <link rel="stylesheet" href="/css/forum/forum.css">
  <link rel="stylesheet" href="/css/forum/main.css">
  <link rel="stylesheet" href="/css/forum/create.css">
</head>

<body>
  <!-- Desktop nav bar partial -->
  <%- include("../partials/navBarDesktop.ejs", {
    selected: "FORUM",
  }) %>

  <!-- Sidebar -->
  <%- include("../partials/sidebar.ejs") %>

  <!-- Nav bar partial -->
  <%- include("../partials/navBar.ejs", { headerTitle: "FORUM", headerColor: "var(--accent-purple)" }) %>

  <!-- Unverified email popup partial -->
  <% console.log(isVerified); %>
  <%- include("../partials/popup/unverifiedEmailPopup.ejs", { isVisible: !isVerified }) %>

  <!-- Cookies consent banner -->
  <%- include("../partials/popup/cookiesConsentPopup.ejs") %>

  <!-- Main content -->
  <main>
    <!-- Thread select datalist -->

    <!-- Thread section -->
    <section id="content-section-container">
      <!-- Post creating header -->
      <div id="post-create-header" class="section-header">
        <h2 id="post-create-header-text" class="section-header-text text-shadow">Create A Post</h2>
      </div>

      <!-- Post creating -->
      <form id="post-create-container" class="form-container" method="POST" action="/api/thread/post" enctype="multipart/form-data">
        <div id="post-create-option-container">
          <label for="post-create-option-thread-select" class="font-poppins">Topics</label>
          <select id="post-create-option-thread-select" class="input-field font-poppins" type="text" list="thread-list" default="Select a topic!" <%= locals.user.isRestricted ? `disabled aria-disabled="true"` : `` %>>
            <% topics.forEach((topic) => { %>
            <% if (topic.allowedRole <= user.role) { %>
            <option value=<%= topic._id %> id=<%= topic._id %>><%= topic.name %> </option>
            <% } %>
            <% }) %>
          </select>

          <label for="post-create-option-title" class="font-poppins">Title</label>
          <input id="post-create-option-title" class="input-field font-poppins" type="text" name="bio" placeholder="Make sure it's at least 5 characters!" <%= locals.user.isRestricted ? `disabled aria-disabled="true"` : `` %> pattern=".{5,32}">
        </div>

        <textarea id="post-create-input" class="longtext-input-field input-field font-poppins" type="text" name="bio" placeholder="Write the content..." autocomplete="off" oninput='this.style.height = "";this.style.height = this.scrollHeight + "px"' <%= locals.user.isRestricted ? `disabled aria-disabled="true"` : `` %> pattern=".{3,}"></textarea>

        <div id="post-create-btn-container" style="display: <%= locals.user.isRestricted ? "none" : "flex" %>;">
          <input id="post-create-attachments" type="file" class="form-btn" value="Upload Image" name="attachment" accept="image/*">
          <input id="post-create-submit" class="form-btn" type="submit" value="Post" name="submit">
        </div>

        <div id="post-create-restricted" style="display: <%= locals.user.isRestricted ? "flex" : "none" %>;">
          <p class="font-poppins" id="post-create-restricted-text">You are restricted from the forum</p>
        </div>
      </form>

    </section>
  </main>

  <!-- Forum actions partial -->
  <%- include("../partials/forum/forumAction.ejs") %>
</body>

</html>