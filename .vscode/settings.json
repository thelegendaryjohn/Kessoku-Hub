{
	"editor.tabSize": 4,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"stylua.targetReleaseVersion": "latest",
	"emmet.includeLanguages": {
		"ejs": "html"
	},
	"[html]": {
		"editor.defaultFormatter": "j69.ejs-beautify"
	},

	"files.associations": {
		"*.ejs": "html"
	},
	"html.format.templating": true
}
